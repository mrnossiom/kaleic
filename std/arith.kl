#lang_item("AddTrait")
trait Add<T> {
	type Output;
	fn add(self: &Self, other: T) Self::Output;
}

#lang_item("AddAssignTrait")
trait AddAssign<T> {
	fn add_assign(self: &/*mut*/ Self, other: T);
}

#lang_item("SubTrait")
trait Sub<T> {
	type Output;
	fn sub(self: &Self, other: T) Self::Output;
}

#lang_item("SubAssignTrait")
trait SubAssign<T> {
	fn sub_assign(self: &/*mut*/ Self, other: T);
}

#lang_item("uint_ty")
struct uint;

#lang_item("sint_ty")
struct sint;

#lang_item("float_ty")
struct float;

#lang_item("bool_ty")
struct bool;

for uint impl Add<uint> {
	type Output = uint;
	fn add(self: &Self, other: uint) Self::Output {
		self::internal::add(self, other)
	}
}

for uint impl Sub<uint> {
	type Output = uint;
	fn sub(self: &Self, other: uint) Self::Output {
		self::internal::sub(self, other)
	}
}

for uint impl SubAssign<uint> {
	fn sub_assign(self: &/*mut*/ Self, other: uint) Self::Output {
		// sugar for `self.add(other)` that is sugar for `self::internal::sub(self, other)`
		self.* = self + other;
	}
}

#internal
unsafe extern {
	fn add(a: uint, b: uint) uint;
	fn sub(a: uint, b: uint) uint;
	fn mul(a: uint, b: uint) uint;
	fn div(a: uint, b: uint) uint;
	fn urem(a: uint, b: uint) uint;
	fn srem(a: uint, b: uint) uint;

	fn shl(a: uint, b: uint) uint;
	fn shr(a: uint, b: uint) uint;

	fn or_(a: uint, b: uint) uint;
	fn and_(a: uint, b: uint) uint;
	fn xor(a: uint, b: uint) uint;
}
