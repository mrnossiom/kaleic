fn main() uint {
	let n = 0;

	while n != 5 {
		let res = fibo(n);

		print_num(res);
		putchar(10); // newline
		
		n = n + 1;
	};

	0
}

fn num_to_ascii(n: uint) uint /*Option<Number>*/ {
	if n <= 9 {
		let num_ascii_base = 48;
		// Some(num_ascii_base + n)
		num_ascii_base + n
	} else {
		// None
		21
	}
}

fn print_num_rev(n: uint) {
	if n == 0 {
		putchar(num_to_ascii(0));
	} else {
		while n != 0 {
			let rest = n % 10;
			n = n / 10;
			putchar(num_to_ascii(rest));
		}
	};
}

fn print_num(n: uint) {
    if n == 0 {
        putchar(num_to_ascii(0));
        return;
    };

    // Calculate the divisor to get the most significant digit
    let divisor = 1;
    let temp = n;
    while temp >= 10 {
        temp = temp / 10;
        divisor = divisor * 10;
    };

    // Reset temp to the original number
    temp = n;

    // Print each digit from most to least significant
    while divisor > 0 {
		// Get the current most significant digit
        let digit = temp / divisor;
        putchar(num_to_ascii(digit));
        
        // Remove the most significant digit
        temp = temp % divisor;
        
        // Reduce divisor
        divisor = divisor / 10;
    };
}

fn fibo(n: uint) uint {
	let a = 0;
	let b = 1;

	while n != 0 {
		let next = a + b;
		a = b;
		b = next;

		n = n - 1;
	};

	b
}
