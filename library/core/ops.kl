#lang_item("AddTrait")
trait Add<Rhs = Self> {
	type Output;
	def add(self: Self, other: Rhs) Self::Output;
}

#lang_item("AddAssignTrait")
trait AddAssign<Rhs = Self> {
	// def add_assign(self: &mut Self, other: Rhs);
	def add_assign(self: *Self, other: Rhs);
}

#lang_item("SubTrait")
trait Sub<Rhs = Self> {
	type Output;
	def sub(self: Self, other: Rhs) Self::Output;
}

#lang_item("SubAssignTrait")
trait SubAssign<Rhs = Self> {
	// def sub_assign(self: &mut Self, other: Rhs);
	def sub_assign(self: *Self, other: Rhs);
}

#lang_item("NotTrait")
trait Not {
	def not_(self: Self) Self;
}
